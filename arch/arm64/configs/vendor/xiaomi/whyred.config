# Platform
CONFIG_MACH_XIAOMI_WHYRED=y

# Camera
CONFIG_MSMB_CAMERA_LEGACY=y

# Hall sensor
CONFIG_INPUT_HALL_SENSOR_E7S=y

# Touchscreen
CONFIG_TOUCHSCREEN_NVT_E7S=y
CONFIG_TOUCHSCREEN_SYNAPTICS_DSX_E7S=y
CONFIG_TOUCHSCREEN_SYNAPTICS_DSX_E7S_I2C=y
# CONFIG_TOUCHSCREEN_SYNAPTICS_DSX_E7S_SPI is not set
# CONFIG_TOUCHSCREEN_SYNAPTICS_DSX_E7S_RMI_HID_I2C is not set
CONFIG_TOUCHSCREEN_SYNAPTICS_DSX_E7S_CORE=y
CONFIG_TOUCHSCREEN_SYNAPTICS_DSX_E7S_RMI_DEV=y
CONFIG_TOUCHSCREEN_SYNAPTICS_DSX_E7S_FW_UPDATE=y
CONFIG_TOUCHSCREEN_SYNAPTICS_DSX_E7S_FW_UPDATE_EXTRA_SYSFS=y
CONFIG_TOUCHSCREEN_SYNAPTICS_DSX_E7S_GESTURE=y
CONFIG_TOUCHSCREEN_SYNAPTICS_DSX_E7S_TEST_REPORTING=y
# CONFIG_TOUCHSCREEN_SYNAPTICS_DSX_E7S_PROXIMITY is not set
# CONFIG_TOUCHSCREEN_SYNAPTICS_DSX_E7S_ACTIVE_PEN is not set
# CONFIG_TOUCHSCREEN_SYNAPTICS_DSX_E7S_VIDEO is not set
# CONFIG_TOUCHSCREEN_SYNAPTICS_DSX_E7S_DEBUG is not set

# Storage & Filesystems
# CONFIG_F2FS_IOSTAT is not set
# CONFIG_IOSCHED_BFQ is not set
# CONFIG_BFQ_GROUP_IOSCHED is not set

# Memory & Kernel Modules
# CONFIG_RANDOMIZE_MODULE_REGION_FULL is not set

# Errata cleanup (Datacenter / Falkor server silicon not present on Kryo 260)
# CONFIG_QCOM_FALKOR_ERRATUM_1003 is not set
# CONFIG_QCOM_FALKOR_ERRATUM_1009 is not set
# CONFIG_QCOM_QDF2400_ERRATUM_0065 is not set
# CONFIG_QCOM_FALKOR_ERRATUM_E1041 is not set

# ReSukiSU & SuSFS v2.3.0
CONFIG_KSU=y
CONFIG_KSU_SUSFS=y
CONFIG_KSU_MULTI_MANAGER_SUPPORT=y

# Localversion
CONFIG_LOCALVERSION="-perf-resukisu"
